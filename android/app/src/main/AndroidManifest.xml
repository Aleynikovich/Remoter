<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.INTERNET" />
    <!-- For installing updates from GitHub releases from inside the app. -->
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" />

    <!-- A mouse or keyboard is optional; the app works with touch alone. -->
    <uses-feature android:name="android.hardware.touchscreen" android:required="false" />

    <application
        android:allowBackup="false"
        android:icon="@drawable/ic_launcher"
        android:label="@string/app_name"
        android:resizeableActivity="true"
        android:supportsRtl="false"
        android:theme="@style/Theme.Remoter"
        android:usesCleartextTraffic="true">

        <activity
            android:name=".ConnectActivity"
            android:configChanges="orientation|screenSize|smallestScreenSize|screenLayout|density|keyboard|keyboardHidden|navigation|uiMode"
            android:exported="true"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Folding and unfolding, rotating, plugging in a keyboard or
             switching to DeX are all handled in place, so the session (and
             its connection) survives them. -->
        <activity
            android:name=".SessionActivity"
            android:configChanges="orientation|screenSize|smallestScreenSize|screenLayout|density|keyboard|keyboardHidden|navigation|uiMode|fontScale"
            android:exported="false"
            android:launchMode="singleTop"
            android:theme="@style/Theme.Remoter.Session"
            android:windowSoftInputMode="adjustNothing|stateHidden" />

        <receiver
            android:name=".InstallReceiver"
            android:exported="false" />

        <!-- Samsung DeX: run as a normal resizable window and keep running
             when switching in and out of DeX. -->
        <meta-data android:name="com.samsung.android.keepalive.density" android:value="true" />
        <meta-data android:name="com.samsung.android.multidisplay.keep_process_alive" android:value="true" />
    </application>
</manifest>
