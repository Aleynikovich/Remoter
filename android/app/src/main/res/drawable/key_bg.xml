<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_pressed="true">
        <shape><solid android:color="#4C8DFF" /><corners android:radius="6dp" /></shape>
    </item>
    <item android:state_activated="true">
        <shape><solid android:color="#2F6FEB" /><corners android:radius="6dp" /></shape>
    </item>
    <item android:state_selected="true">
        <shape><solid android:color="#2F6FEB" /><stroke android:width="2dp" android:color="#FFFFFF" /><corners android:radius="6dp" /></shape>
    </item>
    <item>
        <shape><solid android:color="#2A2E37" /><corners android:radius="6dp" /></shape>
    </item>
</selector>
